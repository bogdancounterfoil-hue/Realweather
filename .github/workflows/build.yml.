name: build
on:
  push:
  workflow_dispatch:
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 21
      - name: Unzip project
        run: unzip -q realweather.zip -d project
      - name: Build
        run: |
          chmod +x gradlew
          ./gradlew build --no-daemon
        working-directory: project/realweather
      - uses: actions/upload-artifact@v4
        with:
          name: realweather-mod
          path: project/realweather/build/libs/realweather-1.0.0.jar
